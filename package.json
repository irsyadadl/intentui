{
  "name": "intentui",
  "version": "3.0.0",
  "private": true,
  "author": "irsyadadl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irsyadadl/intentui.git"
  },
  "scripts": {
    "first-time": "npm install && npm run build && next dev",
    "lint": "oxlint",
    "build:stubs": "rm -rf public/stubs && node --import tsx src/scripts/build-stubs.ts",
    "build:llms": "node --import tsx src/scripts/generate-llms.ts",
    "build:search": "node --import tsx src/scripts/generate-search.ts",
    "build:icons": "node --import tsx src/scripts/generate-icon-metadata.ts",
    "prebuild": "npx fumadocs-mdx && npm run build:icons && npm run build:search && npm run build:llms && npm run registry:generate && node --import tsx src/scripts/extract-components-from-registry.ts && npm run build:stubs",
    "cuc": "node --import tsx src/scripts/check-use-client.ts",
    "cdc": "node --import tsx src/scripts/check-duplicated-classes.ts",
    "registry:generate": "node --import tsx src/scripts/generate-registry.ts && npx shadcn build && node --import tsx src/scripts/cleanup-staged.ts",
    "r": "npm run release && npm run registry:generate",
    "gr": "node --import tsx src/scripts/generate-release-notes.ts",
    "release": "npm run gr && npm run build:search",
    "dev": "next dev --turbopack",
    "build": "_FUMADOCS_MDX=1 next build --webpack",
    "format": "oxlint --fix && oxfmt .",
    "start": "next start",
    "preview": "npm run build && next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@intentui/icons": "^1.11.3",
    "@react-aria/i18n": "^3.13.0",
    "@react-stately/color": "^3.10.0",
    "@react-stately/data": "^3.16.0",
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "@wandry/analytics-sdk": "^1.16.0",
    "cn": "^0.2.4",
    "culori": "^4.0.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.8.10",
    "fumadocs-mdx": "^15.0.3",
    "input-otp": "^1.4.2",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "ntcjs": "^1.1.3",
    "onedollarstats": "^0.0.23",
    "react": "^19.2.6",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.6",
    "react-intersection-observer": "^10.0.3",
    "react-resizable-panels": "^4.11.0",
    "recharts": "^3.8.1",
    "rehype-stringify": "^10.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.4",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-variants": "^3.2.2",
    "tailwindcss-react-aria-components": "^2.1.1",
    "textarea-caret": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@react-aria/test-utils": "^1.0.0-rc.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/textarea-caret": "^3.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.29",
    "encoding": "^0.1.13",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.64.0",
    "postcss": "^8.5.14",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "shadcn": {
      "zod": "3.25.76"
    }
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "trustedDependencies": [
    "es5-ext",
    "esbuild",
    "sharp"
  ]
}
